+fn runtime_idle_duration(expiry_unix_secs: u64, now_unix_secs: u64) -> Result<std::time::Duration> {
+    let remaining = expiry_unix_secs.saturating_sub(now_unix_secs);
+    if remaining > RUNTIME_IDLE_MAX_SECONDS {
+        return Err(miette::miette!(
+            "runtime idle expiry exceeds the bounded one-day maximum"
+        ));
+    }
+    Ok(std::time::Duration::from_secs(remaining))
+}
+
+fn run_runtime_idle_until(args: &[String]) -> Result<()> {
+    if args.len() != 2
+        || args[0] != "--unix-seconds"
+        || args[1].is_empty()
+        || !args[1].bytes().all(|byte| byte.is_ascii_digit())
+        || (args[1].len() > 1 && args[1].starts_with('0'))
+    {
+        return Err(miette::miette!(
+            "usage: openshell-sandbox {RUNTIME_IDLE_UNTIL_SUBCOMMAND} --unix-seconds <canonical-expiry>"
+        ));
+    }
+    let expiry_unix_secs = args[1]
+        .parse::<u64>()
+        .map_err(|_| miette::miette!("runtime idle expiry is invalid"))?;
+    let now_unix_secs = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_err(|_| miette::miette!("system clock predates Unix epoch"))?
+        .as_secs();
+    let remaining = runtime_idle_duration(expiry_unix_secs, now_unix_secs)?;
+    if !remaining.is_zero() {
+        std::thread::sleep(remaining);
+    }
+    Ok(())
+}
