+const MIN_DOCKER_DISK_LIMIT_BYTES: u64 = 1_048_576;
+const MAX_DOCKER_DISK_LIMIT_BYTES: u64 = 1_099_511_627_776;
+
+fn parse_docker_disk_limit_bytes(value: Option<&str>) -> Result<Option<u64>, Status> {
+    let Some(value) = value else {
+        return Ok(None);
+    };
+    if value.is_empty() || !value.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err(Status::failed_precondition(
+            "docker disk_limit_bytes must be a canonical decimal byte string",
+        ));
+    }
+    let bytes = value.parse::<u64>().map_err(|_| {
+        Status::failed_precondition("docker disk_limit_bytes is outside the supported range")
+    })?;
+    if !(MIN_DOCKER_DISK_LIMIT_BYTES..=MAX_DOCKER_DISK_LIMIT_BYTES).contains(&bytes)
+        || bytes.to_string() != value
+    {
+        return Err(Status::failed_precondition(format!(
+            "docker disk_limit_bytes must be a canonical decimal between {MIN_DOCKER_DISK_LIMIT_BYTES} and {MAX_DOCKER_DISK_LIMIT_BYTES}"
+        )));
+    }
+    Ok(Some(bytes))
+}
+
+fn parse_docker_sandbox_pids_limit(
+    value: Option<&str>,
+) -> Result<Option<std::num::NonZeroI64>, Status> {
+    let Some(value) = value else {
+        return Ok(None);
+    };
+    if value.is_empty() || !value.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err(Status::failed_precondition(
+            "docker pids_limit must be a canonical decimal process count",
+        ));
+    }
+    let count = value.parse::<i64>().map_err(|_| {
+        Status::failed_precondition("docker pids_limit is outside the supported range")
+    })?;
+    if !(16..=16_384).contains(&count) || count.to_string() != value {
+        return Err(Status::failed_precondition(
+            "docker pids_limit must be a canonical decimal between 16 and 16384",
+        ));
+    }
+    Ok(std::num::NonZeroI64::new(count))
+}
+
+fn validate_disk_limited_mounts(
+    disk_limited: bool,
+    mounts: &[DockerDriverMountConfig],
+    image_volumes: &[String],
+) -> Result<(), Status> {
+    if !disk_limited {
+        return Ok(());
+    }
+    if !image_volumes.is_empty() {
+        return Err(Status::failed_precondition(
+            "docker disk-limited sandboxes cannot use image-declared writable volumes",
+        ));
+    }
+    for mount in mounts {
+        let writable = match mount {
+            DockerDriverMountConfig::Bind { read_only, .. }
+            | DockerDriverMountConfig::Volume { read_only, .. }
+            | DockerDriverMountConfig::Image { read_only, .. } => !read_only,
+            DockerDriverMountConfig::Tmpfs { options, .. } => {
+                let read_only = options.iter().any(|option| option == "ro");
+                let explicitly_writable = options.iter().any(|option| option == "rw");
+                // Docker option order can make contradictory ro/rw flags
+                // ambiguous. A disk-limited profile admits only an explicit,
+                // unambiguous read-only tmpfs mount.
+                !read_only || explicitly_writable
+            }
+        };
+        if writable {
+            return Err(Status::failed_precondition(
+                "docker disk-limited sandboxes cannot use writable external mounts",
+            ));
+        }
+    }
+    Ok(())
+}
