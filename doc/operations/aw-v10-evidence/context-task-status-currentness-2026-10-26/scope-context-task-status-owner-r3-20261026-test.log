mmaries\'->\'items\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'outputSummaries\'->\'items\' else \'[]\'::jsonb end)<=5\n    and jsonb_array_length(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'outputSummaries\'->\'items\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'outputSummaries\'->\'items\' else \'[]\'::jsonb end)=(select count(distinct output.item->>\'id\')\n      from jsonb_array_elements(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'outputSummaries\'->\'items\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'outputSummaries\'->\'items\' else \'[]\'::jsonb end) output(item))\n    and rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\' ~ \'^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$\'\n    and jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\')=\'array\'\n    and jsonb_array_length(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\' else \'[]\'::jsonb end)<=256\n    and jsonb_array_length(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\' else \'[]\'::jsonb end)=(select count(distinct source.id) from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\' else \'[]\'::jsonb end) source(id))\n    and jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\')=\'array\'\n    and jsonb_array_length(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\' else \'[]\'::jsonb end)<=256\n    and jsonb_array_length(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\' else \'[]\'::jsonb end)=(select count(distinct source.id) from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\' else \'[]\'::jsonb end) source(id))\n    and not exists(select 1 from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\' else \'[]\'::jsonb end) source(id)\n      where source.id !~* \'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\')\n    and not exists(select 1 from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'taskSourceIssueIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'taskSourceIssueIds\' else \'[]\'::jsonb end) source(id)\n      where source.id !~* \'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\')\n    and exists(select 1 from pipeline_automation_executions e\n      join pipeline_cases c on c.id=e.case_id and c.company_id=e.company_id\n      join pipeline_stages s on s.id=case when rr.trigger_payload->\'contextPack\'->\'stage\'->>\'id\' ~* \'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n        then (rr.trigger_payload->\'contextPack\'->\'stage\'->>\'id\')::uuid end and s.pipeline_id=c.pipeline_id\n      join pipeline_case_events ev on ev.id=case when rr.trigger_payload->>\'triggeringEventId\' ~* \'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n        then (rr.trigger_payload->>\'triggeringEventId\')::uuid end and ev.case_id=c.id and ev.company_id=c.company_id\n      where e.id=case when rr.trigger_payload->\'automation\'->>\'automationExecutionId\' ~* \'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n          then (rr.trigger_payload->\'automation\'->>\'automationExecutionId\')::uuid end\n        and e.company_id="issues"."company_id"::uuid and e.routine_id=rr.routine_id and e.target_kind=\'routine\'\n        and e.target_ref=rr.routine_id and e.case_id=c.id and c.pipeline_id::text=p.origin_id\n        and c.retired_at is null and c.hidden_from_board_at is null\n        and e.automation_id=rr.trigger_payload->\'automation\'->>\'automationId\'\n        and e.generation::text=rr.trigger_payload->\'automation\'->>\'generation\'\n        and e.triggering_event_id=case when rr.trigger_payload->>\'triggeringEventId\' ~* \'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n          then (rr.trigger_payload->>\'triggeringEventId\')::uuid end\n        and rr.trigger_payload->\'contextPack\'->\'case\'->>\'sourceUserId\' is not distinct from c.created_by_user_id\n        and rr.trigger_payload->\'contextPack\'->\'case\'->>\'sourceAgentId\' is not distinct from c.created_by_agent_id::text\n        and rr.trigger_payload->\'contextPack\'->\'case\'->>\'sourceRunId\' is not distinct from c.origin_run_id::text\n        and ((c.created_by_user_id is not null and c.created_by_agent_id is null and c.origin_run_id is null)\n          or (c.created_by_user_id is null and c.created_by_agent_id is not null and c.origin_run_id is not null\n              and exists(select 1 from heartbeat_runs producer_run\n                where producer_run.id=c.origin_run_id and producer_run.company_id=c.company_id\n                  and producer_run.agent_id=c.created_by_agent_id)))\n        and (select count(distinct source.id) from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\' else \'[]\'::jsonb end) source(id))\n          =(select count(distinct expected.id) from (select c.origin_run_id::text as id where c.origin_run_id is not null\n              union all select ev.run_id::text from pipeline_case_events ev where ev.company_id=c.company_id and ev.case_id=c.id\n                and ev.type=\'updated\' and ev.payload->>\'materialChanged\'=\'true\' and ev.actor_type=\'agent\'\n                and ev.run_id is not null and ev.created_at<=case when rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\' ~ \'^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$\'\n    then (rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\')::timestamptz else \'epoch\'::timestamptz end) expected)\n        and not exists(select 1 from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerRunIds\' else \'[]\'::jsonb end) source(id)\n          where not (source.id=c.origin_run_id::text or exists(select 1 from pipeline_case_events ev\n            where ev.company_id=c.company_id and ev.case_id=c.id and ev.type=\'updated\'\n              and ev.payload->>\'materialChanged\'=\'true\' and ev.actor_type=\'agent\' and ev.run_id::text=source.id\n              and ev.created_at<=case when rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\' ~ \'^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$\'\n    then (rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\')::timestamptz else \'epoch\'::timestamptz end)))\n        and (select count(distinct source.id) from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\' else \'[]\'::jsonb end) source(id))\n          =(select count(distinct expected.id) from (select c.created_by_user_id as id where c.created_by_user_id is not null\n              union all select ev.actor_user_id from pipeline_case_events ev where ev.company_id=c.company_id and ev.case_id=c.id\n                and ev.type=\'updated\' and ev.payload->>\'materialChanged\'=\'true\' and ev.actor_type=\'user\'\n                and ev.actor_user_id is not null and ev.created_at<=case when rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\' ~ \'^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$\'\n    then (rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\')::timestamptz else \'epoch\'::timestamptz end) expected)\n        and not exists(select 1 from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'case\'->\'producerUserIds\' else \'[]\'::jsonb end) source(id)\n          where not (source.id=c.created_by_user_id or exists(select 1 from pipeline_case_events ev\n            where ev.company_id=c.company_id and ev.case_id=c.id and ev.type=\'updated\'\n              and ev.payload->>\'materialChanged\'=\'true\' and ev.actor_type=\'user\' and ev.actor_user_id=source.id\n              and ev.created_at<=case when rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\' ~ \'^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$\'\n    then (rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\')::timestamptz else \'epoch\'::timestamptz end)))\n        and not exists(select 1 from pipeline_case_events ev where ev.company_id=c.company_id and ev.case_id=c.id\n          and ev.type=\'updated\' and ev.payload->>\'materialChanged\'=\'true\' and ev.actor_type=\'system\' and ev.created_at<=case when rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\' ~ \'^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$\'\n    then (rr.trigger_payload->\'contextPack\'->\'case\'->>\'capturedAt\')::timestamptz else \'epoch\'::timestamptz end)\n        and (select count(distinct source.id) from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'taskSourceIssueIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'taskSourceIssueIds\' else \'[]\'::jsonb end) source(id))\n          =(select count(distinct link.issue_id) from pipeline_case_issue_links link\n            where link.company_id=e.company_id and link.case_id=c.id and link.created_at<=e.created_at)\n        and not exists(select 1 from pipeline_case_issue_links link where link.company_id=e.company_id\n          and link.case_id=c.id and link.created_at<=e.created_at\n          and not exists(select 1 from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'taskSourceIssueIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'taskSourceIssueIds\' else \'[]\'::jsonb end) source(id) where source.id=link.issue_id::text))\n        and not exists(select 1 from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'taskSourceIssueIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'taskSourceIssueIds\' else \'[]\'::jsonb end) source(id)\n          where not exists(select 1 from pipeline_case_issue_links link\n            join issues source_issue on source_issue.company_id=link.company_id and source_issue.id=link.issue_id\n            where link.company_id=e.company_id and link.case_id=c.id and link.created_at<=e.created_at\n              and link.issue_id::text=source.id and source_issue.hidden_at is null\n              and source_issue.cancelled_at is null and source_issue.status<>\'cancelled\'))\n        and not exists(select 1 from jsonb_array_elements(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'outputSummaries\'->\'items\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'outputSummaries\'->\'items\' else \'[]\'::jsonb end) output(item) where not (\n          output.item->\'sourceIssue\'->>\'id\' ~* \'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n          and exists(select 1 from jsonb_array_elements_text(case when jsonb_typeof(rr.trigger_payload->\'contextPack\'->\'taskSourceIssueIds\')=\'array\'\n    then rr.trigger_payload->\'contextPack\'->\'taskSourceIssueIds\' else \'[]\'::jsonb end) source(id)\n            where source.id=output.item->\'sourceIssue\'->>\'id\')\n          and case output.item->>\'kind\'\n            when \'document\' then output.item->>\'id\' ~* \'^document:[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n              and output.item->>\'revisionId\' ~* \'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n              and exists(select 1 from issue_documents link\n                join documents d on d.company_id=link.company_id and d.id=link.document_id\n                join issues source_issue on source_issue.company_id=link.company_id and source_issue.id=link.issue_id\n                join document_revisions rev on rev.company_id=d.company_id and rev.document_id=d.id\n                  and rev.id=case when output.item->>\'revisionId\' ~* \'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n                    then (output.item->>\'revisionId\')::uuid end\n                where link.company_id=e.company_id\n                  and link.issue_id=case when output.item->\'sourceIssue\'->>\'id\' ~* \'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n                    then (output.item->\'sourceIssue\'->>\'id\')::uuid end\n                  and link.document_id=case when output.item->>\'id\' ~* \'^document:[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n                    then substring(output.item->>\'id\' from 10)::uuid end\n                  and link.key=output.item->>\'key\'\n                  and coalesce(d.source_trust,source_issue.source_trust,\'null\'::jsonb)\n                    is not distinct from coalesce(output.item->\'sourceTrust\',\'null\'::jsonb))\n            when \'work_product\' then output.item->>\'id\' ~* \'^work_product:[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\'\n              and exists(select 1 from issue_work_products wp\n                join issues source_issue on source_issue.company_id=wp.company_id 