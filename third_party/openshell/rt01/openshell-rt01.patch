+/// Saturate only the sandbox's own bounded PID cgroup, then kill and reap
+/// every child before returning. The expected limit is supplied by the host
+/// only after it has independently inspected the same immutable container.
+#[cfg(target_os = "linux")]
+#[allow(unsafe_code)]
+fn run_runtime_pids_probe(args: &[String]) -> Result<()> {
+    if args.len() != 2
+        || args[0] != "--limit"
+        || args[1].is_empty()
+        || !args[1].bytes().all(|byte| byte.is_ascii_digit())
+        || (args[1].len() > 1 && args[1].starts_with('0'))
+    {
+        return Err(miette::miette!(
+            "usage: openshell-sandbox {RUNTIME_PIDS_PROBE_SUBCOMMAND} --limit <canonical-pids-limit>"
+        ));
+    }
+    let expected_limit = args[1]
+        .parse::<u32>()
+        .map_err(|_| miette::miette!("runtime PID limit is invalid"))?;
+    if !(1..=RUNTIME_PIDS_PROBE_MAX).contains(&expected_limit) {
+        println!(
+            "{}",
+            serde_json::json!({"version":1,"verdict":"unsupported"})
+        );
+        return Ok(());
+    }
+    let actual_limit = match std::fs::read_to_string("/sys/fs/cgroup/pids.max") {
+        Ok(value) => value.trim().parse::<u32>().ok(),
+        Err(_) => None,
+    };
+    let baseline = match std::fs::read_to_string("/sys/fs/cgroup/pids.current") {
+        Ok(value) => value.trim().parse::<u32>().ok(),
+        Err(_) => None,
+    };
+    let (Some(actual_limit), Some(baseline)) = (actual_limit, baseline) else {
+        println!(
+            "{}",
+            serde_json::json!({"version":1,"verdict":"unsupported"})
+        );
+        return Ok(());
+    };
+    if actual_limit != expected_limit || baseline >= actual_limit {
+        println!(
+            "{}",
+            serde_json::json!({"version":1,"verdict":"unsupported"})
+        );
+        return Ok(());
+    }
+
+    let attempts = actual_limit.saturating_sub(baseline).saturating_add(1);
+    let mut children = Vec::with_capacity(attempts as usize);
+    let mut denied_errno = None;
+    for _ in 0..attempts {
+        // SAFETY: each child runs only pause() and exits after the parent
+        // sends SIGKILL. The parent owns every returned PID and reaps it.
+        let pid = unsafe { libc::fork() };
+        if pid == 0 {
+            loop {
+                unsafe {
+                    libc::pause();
+                }
+            }
+        }
+        if pid < 0 {
+            denied_errno = std::io::Error::last_os_error().raw_os_error();
+            break;
+        }
+        children.push(pid);
+    }
+    for pid in &children {
+        unsafe {
+            libc::kill(*pid, libc::SIGKILL);
+        }
+    }
+    let mut reaped = 0_u32;
+    for pid in &children {
+        let mut status = 0;
+        if unsafe { libc::waitpid(*pid, &mut status, 0) } == *pid {
+            reaped += 1;
+        }
+    }
+    let after = std::fs::read_to_string("/sys/fs/cgroup/pids.current")
+        .ok()
+        .and_then(|value| value.trim().parse::<u32>().ok());
+    let contained = denied_errno == Some(libc::EAGAIN)
+        && children.len() < attempts as usize
+        && reaped as usize == children.len()
+        && after.is_some_and(|count| count <= baseline);
+    println!(
+        "{}",
+        serde_json::json!({
+            "version": 1,
+            "verdict": if contained { "pass" } else { "fail" },
+            "limit": actual_limit,
+            "baseline": baseline,
+            "attempted": children.len() + usize::from(denied_errno.is_some()),
+            "denied_errno": if denied_errno == Some(libc::EAGAIN) { "EAGAIN" } else { "other" },
+            "reaped": reaped,
+            "baseline_restored": after.is_some_and(|count| count <= baseline)
+        })
+    );
+    Ok(())
+}
