+pub(super) fn validate_identity_rpc_precondition(
+    identity_bound: bool,
+    expected_sandbox_id: &str,
+    identity_method: &str,
+) -> Result<(), Status> {
+    if identity_bound && expected_sandbox_id.is_empty() {
+        return Err(Status::invalid_argument(
+            "expected_sandbox_id is required for identity-bound mutation",
+        ));
+    }
+    if !identity_bound && !expected_sandbox_id.is_empty() {
+        return Err(Status::failed_precondition(format!(
+            "use {identity_method} when supplying expected_sandbox_id"
+        )));
+    }
+    Ok(())
+}
