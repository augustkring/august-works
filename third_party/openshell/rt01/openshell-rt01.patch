+#[cfg(not(target_os = "linux"))]
+fn run_runtime_disk_probe(_args: &[String]) -> Result<()> {
+    println!(
+        "{}",
+        serde_json::json!({"version":1,"verdict":"unsupported"})
+    );
+    Ok(())
+}
