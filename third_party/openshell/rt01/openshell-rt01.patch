+            "{}",
+            serde_json::json!({"version":1,"verdict":"unsupported"})
+        );
+        return Ok(());
+    }
+    let started = std::time::Instant::now();
+    let deadline = started + std::time::Duration::from_millis(millis);
+    let mut tasks = Vec::with_capacity(workers as usize);
+    for _ in 0..workers {
+        tasks.push(std::thread::spawn(move || {
+            let mut value = 1_u64;
