+#[cfg(target_os = "linux")]
+fn run_runtime_memory_child(args: &[String]) -> Result<()> {
+    if args.len() != 2 || args[0] != "--limit-bytes" {
+        return Err(miette::miette!("invalid memory-probe child arguments"));
+    }
+    let expected = parse_canonical_u64(&args[1], "memory limit")?;
+    if !(16 * 1024 * 1024..=RUNTIME_MEMORY_PROBE_MAX_BYTES).contains(&expected)
+        || read_cgroup_counter("/sys/fs/cgroup/memory.max", None) != Some(expected)
+        || std::fs::read_to_string("/sys/fs/cgroup/memory.oom.group")
+            .ok()
+            .map(|value| value.trim().to_string())
+            .as_deref()
+            != Some("0")
+    {
+        std::process::exit(72);
+    }
+    if std::fs::write("/proc/self/oom_score_adj", "1000").is_err() {
+        std::process::exit(73);
+    }
+    let requested = usize::try_from(expected + 4096).into_diagnostic()?;
+    let mut bytes = Vec::<u8>::new();
+    if bytes.try_reserve_exact(requested).is_err() {
+        std::process::exit(74);
+    }
+    bytes.resize(requested, 0);
+    for offset in (0..requested).step_by(4096) {
+        bytes[offset] = 1;
+    }
+    std::hint::black_box(bytes);
+    std::process::exit(0);
+}
