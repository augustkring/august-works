+#[cfg(target_os = "linux")]
+fn run_runtime_disk_probe(args: &[String]) -> Result<()> {
+    if args.len() != 4 || args[0] != "--limit-bytes" || args[2] != "--path" {
+        return Err(miette::miette!(
+            "usage: openshell-sandbox {RUNTIME_DISK_PROBE_SUBCOMMAND} --limit-bytes <canonical-limit> --path <workspace-marker>"
+        ));
+    }
+    let limit = parse_canonical_u64(&args[1], "disk limit")?;
+    let target = Path::new(&args[3]);
+    if !(1..=RUNTIME_DISK_PROBE_MAX_BYTES).contains(&limit)
+        || !target.is_absolute()
+        || target
+            .file_name()
+            .is_none_or(|name| !name.to_string_lossy().starts_with(".aw-v7-disk-probe-"))
+        || target.components().any(|part| {
+            matches!(
+                part,
+                std::path::Component::ParentDir | std::path::Component::CurDir
+            )
+        })
+    {
+        println!(
+            "{}",
+            serde_json::json!({"version":1,"verdict":"unsupported"})
+        );
+        return Ok(());
+    }
+    let Some(parent) = target.parent() else {
+        println!(
+            "{}",
+            serde_json::json!({"version":1,"verdict":"unsupported"})
+        );
+        return Ok(());
+    };
+    let parent_metadata = std::fs::symlink_metadata(parent);
+    let canonical_parent = std::fs::canonicalize(parent);
+    if !parent_metadata
+        .is_ok_and(|metadata| metadata.is_dir() && !metadata.file_type().is_symlink())
+        || !canonical_parent.is_ok_and(|canonical| canonical == parent)
+    {
+        println!(
+            "{}",
+            serde_json::json!({"version":1,"verdict":"unsupported"})
+        );
+        return Ok(());
+    }
+    let mut file = match std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(target)
+    {
+        Ok(file) => file,
+        Err(_) => {
+            println!(
+                "{}",
+                serde_json::json!({"version":1,"verdict":"unsupported"})
+            );
+            return Ok(());
+        }
+    };
+    let chunk = [0x5a_u8; 65_536];
+    let mut written = 0_u64;
+    let mut exhausted = false;
+    while written <= limit {
+        let count =
+            usize::try_from((limit + 1 - written).min(chunk.len() as u64)).unwrap_or(chunk.len());
+        match std::io::Write::write_all(&mut file, &chunk[..count]) {
+            Ok(()) => written += count as u64,
+            Err(error)
+                if matches!(
+                    error.raw_os_error(),
+                    Some(libc::ENOSPC) | Some(libc::EDQUOT)
+                ) =>
+            {
+                exhausted = true;
+                break;
+            }
+            Err(_) => break,
+        }
+    }
+    drop(file);
+    let removed = std::fs::remove_file(target).is_ok() && !target.exists();
+    let contained = exhausted && written <= limit && removed;
+    println!(
+        "{}",
+        serde_json::json!({
+            "version":1,"verdict":if contained { "pass" } else { "unsupported" },
+            "limit_bytes":limit,"quota_exhaustion_observed":exhausted,"temporary_file_removed":removed
+        })
+    );
+    Ok(())
+}
