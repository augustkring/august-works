+
+    fn capture(_: &Response<Self::Output>) -> Result<Success, Status> {
+        Err(uncertain())
+    }
+
+    async fn restore(_: &Store, success: Success) -> Result<Self::Output, Status> {
+        Err(stream_unavailable(success))
+    }
