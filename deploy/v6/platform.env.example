# Copy to the deployment secret store. Configured files must be root-owned and mode 0600.
AW_DEPLOYMENT_PROFILE=saas
AW_PLATFORM_ENV=production
AW_PUBLIC_APP_ORIGIN=https://ai.augustworks.dk
AW_ALLOWED_APP_ORIGINS=
AW_LEGACY_APP_ORIGINS=
TRUST_PROXY=loopback
HOST=127.0.0.1
PORT=3100
SERVE_UI=true
# App DML role. Use the private managed endpoint, sslmode=verify-full and the UpCloud CA chain.
PAPERCLIP_DB_BACKUP_ENABLED=false
DATABASE_URL=
BETTER_AUTH_SECRET=
PAPERCLIP_SECRETS_MASTER_KEY=
PAPERCLIP_STORAGE_PROVIDER=s3
PAPERCLIP_STORAGE_S3_REGION=europe-1
PAPERCLIP_STORAGE_S3_ENDPOINT=
PAPERCLIP_STORAGE_S3_BUCKET=
PAPERCLIP_STORAGE_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RUN_LOG_S3_REGION=europe-1
RUN_LOG_S3_ENDPOINT=
RUN_LOG_S3_BUCKET=
RUN_LOG_S3_FORCE_PATH_STYLE=true
AW_OUTBOX_ENCRYPTION_KEY=
AW_OUTBOX_KEY_ID=initial
AW_OUTBOX_PREVIOUS_KEYS={}
AW_EMAIL_RECIPIENT_HASH_KEY=
MAILGUN_REGION=eu
MAILGUN_API_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_STAGING_RECIPIENTS=
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
AW_PROVIDER_PAYLOAD_KEY=
AW_PROVIDER_PAYLOAD_KEY_ID=initial
AW_PROVIDER_PAYLOAD_PREVIOUS_KEYS={}
AW_BILLING_GRACE_DAYS=7
# Separate object credentials by purpose. None of these go to runtime hosts.
AW_EXPORT_BUCKET=
AW_RUNTIME_BACKUP_BUCKET=
AW_BACKUP_WRITE_ACCESS_KEY_ID=
AW_BACKUP_WRITE_SECRET_ACCESS_KEY=
AW_BACKUP_RESTORE_ACCESS_KEY_ID=
AW_BACKUP_RESTORE_SECRET_ACCESS_KEY=
AW_BACKUP_RETENTION_ACCESS_KEY_ID=
AW_BACKUP_RETENTION_SECRET_ACCESS_KEY=
# Restricted UpCloud subaccount; required only for provider writes/scaling qualification.
UPCLOUD_USERNAME=
UPCLOUD_PASSWORD=
RUNTIME_CONTROL_REGION=dk-cph1
RUNTIME_CONTROL_NETWORK_ID=
RUNTIME_CONTROL_HOST_PLAN=
RUNTIME_CONTROL_OS_TEMPLATE=
RUNTIME_CONTROL_HOST_AGENT_IMAGE=
RUNTIME_CONTROL_MAX_HOSTS=4
RUNTIME_CONTROL_MAX_CREATES_PER_HOUR=2
# EUR cents/month. Zero closes automatic host creation; set an explicit ceiling after pricing qualification.
RUNTIME_CONTROL_MAX_ESTIMATED_MONTHLY_EUR_MINOR=0
RUNTIME_CONTROL_HOST_DISK_GIB=50
RUNTIME_CONTROL_STATE_DISK_GIB=100
RUNTIME_CONTROL_HEARTBEAT_SECONDS=20
RUNTIME_CONTROL_SUSPECT_SECONDS=90
RUNTIME_CONTROL_UNREACHABLE_SECONDS=180
RUNTIME_CONTROL_BACKUP_RETENTION_DAYS=30
RUNTIME_CONTROL_RELAY_PORT=3102
AW_INTERNAL_OPERATOR_USER_IDS=
AW_DEPLOYMENT_IMAGE_DIGEST=
AW_DEPLOYMENT_SOURCE_SHA=
# Defaults remain off in instance settings. This file does not enable product features.

# Independent encrypted durable run-log buffer/archive key; retain previous keys until rekey/retention.
AW_RUN_LOG_ENCRYPTION_KEY=
AW_RUN_LOG_KEY_ID=initial
AW_RUN_LOG_PREVIOUS_KEYS={}
