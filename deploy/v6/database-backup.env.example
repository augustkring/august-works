# Separate operator secret file, root-owned mode 0600. Never use platform.env here.
AW_PLATFORM_ENV=production
AW_DB_BACKUP_DIR=/var/lib/aw-db-backup
AW_DB_BACKUP_DATABASE_URL=
PGSSLROOTCERT=/run/aw/db-ca.pem
AW_DB_BACKUP_KEY_ID=initial
AW_DB_BACKUP_ENCRYPTION_KEY=
AW_DB_BACKUP_PREVIOUS_KEYS={}
AW_DB_BACKUP_MAX_BYTES=34359738368
AW_DEPLOYMENT_SOURCE_SHA=
AW_DB_BACKUP_S3_ENDPOINT=
AW_DB_BACKUP_BUCKET=
# Put-only writer; separate GetObject identity verifies uploads.
AW_DB_BACKUP_ACCESS_KEY_ID=
AW_DB_BACKUP_SECRET_ACCESS_KEY=
AW_DB_RESTORE_ACCESS_KEY_ID=
AW_DB_RESTORE_SECRET_ACCESS_KEY=
# The signed deletion ledger is stored outside database archives.
AW_RESTORE_LEDGER_SIGNING_KEY=
AW_RESTORE_LEDGER_FILE=/var/lib/aw-db-backup/deletion-ledger.json
