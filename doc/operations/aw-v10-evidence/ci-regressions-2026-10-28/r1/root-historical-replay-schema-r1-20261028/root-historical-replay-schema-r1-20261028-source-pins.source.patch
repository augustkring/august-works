-    .replace(/\b[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}\b/gi, "?")
-    .replace(/\b(?:[A-Za-z0-9_-]{32,})\b/g, "?")
-    .replace(/\b\d+(?:\.\d+)?\b/g, "?")
-    .replace(/\s+/g, " ")
