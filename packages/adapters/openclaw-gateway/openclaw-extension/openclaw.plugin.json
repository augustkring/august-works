{
  "id": "blentera-platform",
  "name": "Blentera Platform bridge",
  "description": "Exposes the authenticated, run-scoped Blentera MCP Gateway to the active OpenClaw agent turn.",
  "categories": ["infrastructure"],
  "enabledByDefault": false,
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["paperclipApiOrigins"],
    "properties": {
      "paperclipApiOrigins": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
