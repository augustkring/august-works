# Initial origin; configure credentials through the deployment secret store.
AW_DEPLOYMENT_PROFILE=saas
AW_PUBLIC_APP_ORIGIN=https://ai.augustworks.dk
AW_ALLOWED_APP_ORIGINS=
AW_LEGACY_APP_ORIGINS=
TRUST_PROXY=loopback
HOST=127.0.0.1
PORT=3100
# Required before admission: persisted saas_deployment_profile_v6=true.
# Required auth secret; do not commit the configured value.
BETTER_AUTH_SECRET=
# Required in the later production deployment slice: managed DB/S3 configuration.
# Public signup remains closed until the auth/email implementation is complete.
