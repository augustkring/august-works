+/// Probe the fixed built-in syscall filter from an ordinary sandbox exec
+/// child. The caller must launch this helper through the workload boundary;
+/// this command intentionally does not install its own filter, because doing
+/// so would only test the helper rather than the selected runtime.
+#[cfg(target_os = "linux")]
+#[allow(unsafe_code)]
+fn run_runtime_seccomp_probe() -> Result<()> {
+    use std::ffi::CString;
+
+    // getpid is an innocuous syscall the fixed workload filter must allow.
+    // SAFETY: getpid takes no arguments and has no memory side effects.
+    let allowed_pid = unsafe { libc::syscall(libc::SYS_getpid) };
+    if allowed_pid <= 0 {
+        return Err(miette::miette!(
+            "built-in seccomp allow probe failed: getpid returned {allowed_pid}"
+        ));
+    }
+
+    // memfd_create is unconditionally denied by the pinned built-in filter.
+    let name = CString::new("openshell-seccomp-probe").into_diagnostic()?;
+    // SAFETY: name is NUL terminated and remains live for the syscall; flags
+    // are a valid scalar. A successful descriptor is closed below.
+    let denied_fd =
+        unsafe { libc::syscall(libc::SYS_memfd_create, name.as_ptr(), libc::MFD_CLOEXEC) };
+    if denied_fd >= 0 {
+        // SAFETY: the kernel returned this descriptor to this process.
+        let descriptor = libc::c_int::try_from(denied_fd).into_diagnostic()?;
+        unsafe { libc::close(descriptor) };
+        return Err(miette::miette!(
+            "built-in seccomp deny probe failed: memfd_create unexpectedly succeeded"
+        ));
+    }
+    let errno = std::io::Error::last_os_error().raw_os_error();
+    if errno != Some(libc::EPERM) {
+        return Err(miette::miette!(
+            "built-in seccomp deny probe failed: memfd_create returned errno {errno:?}, expected EPERM"
+        ));
+    }
+
+    println!(
+        "{}",
+        serde_json::json!({
+            "version": 1,
+            "profile": "openshell-linux-built-in-seccomp-v1",
+            "getpid": "allowed",
+            "memfd_create": "denied",
+            "denied_errno": "EPERM"
+        })
+    );
+    Ok(())
+}
+
+#[cfg(not(target_os = "linux"))]
+fn run_runtime_seccomp_probe() -> Result<()> {
+    Err(miette::miette!("runtime seccomp probe requires Linux"))
