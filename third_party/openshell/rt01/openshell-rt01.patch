+/// Observe the actual workload UID/capability state and verify that the
+/// ordinary, policy-bound child cannot reacquire root. This command does not
+/// alter the sandbox or install a substitute security boundary.
+#[cfg(target_os = "linux")]
+#[allow(unsafe_code)]
+fn run_runtime_privilege_probe() -> Result<()> {
+    let uid = unsafe { libc::geteuid() };
+    let status = match std::fs::read_to_string("/proc/self/status") {
+        Ok(status) => status,
+        Err(_) => {
+            println!(
+                "{}",
+                serde_json::json!({"version":1,"verdict":"unsupported"})
+            );
+            return Ok(());
+        }
+    };
+    let effective_capabilities = status
+        .lines()
+        .find_map(|line| line.strip_prefix("CapEff:	"))
+        .and_then(|value| u64::from_str_radix(value.trim(), 16).ok());
+    let Some(effective_capabilities) = effective_capabilities else {
+        println!(
+            "{}",
+            serde_json::json!({"version":1,"verdict":"unsupported"})
+        );
+        return Ok(());
+    };
+    if uid == 0 || effective_capabilities != 0 {
+        println!(
+            "{}",
+            serde_json::json!({
+                "version": 1,
+                "verdict": "fail",
+                "uid_nonroot": uid != 0,
+                "effective_capabilities_zero": effective_capabilities == 0
+            })
+        );
+        return Ok(());
+    }
+
+    // SAFETY: this one-shot probe runs as a non-root workload child with an
+    // empty effective capability set. If the unexpected transition succeeds,
+    // immediately restore the original UID before emitting only a fixed report.
+    let transition = unsafe { libc::setuid(0) };
+    if transition == 0 {
+        let restored = unsafe { libc::setuid(uid) } == 0;
+        if !restored {
+            unsafe { libc::_exit(70) };
+        }
+        println!(
+            "{}",
+            serde_json::json!({
+                "version": 1,
+                "verdict": "fail",
+                "uid_nonroot": true,
+                "effective_capabilities_zero": true,
+                "setuid_root": "allowed"
+            })
+        );
+        return Ok(());
+    }
+    let errno = std::io::Error::last_os_error().raw_os_error();
+    let denied = errno == Some(libc::EPERM);
+    println!(
+        "{}",
+        serde_json::json!({
+            "version": 1,
+            "verdict": if denied { "pass" } else { "unsupported" },
+            "uid_nonroot": true,
+            "effective_capabilities_zero": true,
+            "setuid_root": if denied { "denied" } else { "unknown" },
+            "errno": if denied { "EPERM" } else { "other" }
+        })
+    );
+    Ok(())
+}
