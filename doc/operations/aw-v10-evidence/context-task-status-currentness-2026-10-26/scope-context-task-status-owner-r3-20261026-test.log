      and temporal_owner.payload_source_snapshot->'owner'->>'id'=temporal_owner.id::text
      and captured_input->>'kind'='context'))) and ((n.kind='run' and r.id=n.id)
            or (n.kind='issue' and coalesce(r.issue_id,r.native_issue_id)=n.id
