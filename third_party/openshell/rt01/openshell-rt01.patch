+#[cfg(target_os = "linux")]
+fn run_runtime_memory_probe(args: &[String]) -> Result<()> {
+    if args.len() != 2 || args[0] != "--limit-bytes" {
+        return Err(miette::miette!(
+            "usage: openshell-sandbox {RUNTIME_MEMORY_PROBE_SUBCOMMAND} --limit-bytes <canonical-limit>"
+        ));
+    }
+    let expected = parse_canonical_u64(&args[1], "memory limit")?;
+    let actual = read_cgroup_counter("/sys/fs/cgroup/memory.max", None);
+    let before = read_cgroup_oom_kill();
+    let oom_group = std::fs::read_to_string("/sys/fs/cgroup/memory.oom.group")
+        .ok()
+        .map(|value| value.trim().to_string());
+    if expected < 16 * 1024 * 1024
+        || expected > RUNTIME_MEMORY_PROBE_MAX_BYTES
+        || actual != Some(expected)
+        || before.is_none()
+        || oom_group.as_deref() != Some("0")
+    {
+        println!(
+            "{}",
+            serde_json::json!({"version":1,"verdict":"unsupported"})
+        );
+        return Ok(());
+    }
+    // Spawn the same pinned executable instead of forking this multithreaded
+    // Tokio process. The child rechecks its cgroup limit before allocating,
+    // raises only its own OOM score, and touches at most one page beyond the
+    // explicitly bounded throwaway cgroup ceiling.
+    let executable = std::env::current_exe().into_diagnostic()?;
+    let mut child = match std::process::Command::new(executable)
+        .arg(RUNTIME_MEMORY_CHILD_SUBCOMMAND)
+        .arg("--limit-bytes")
+        .arg(expected.to_string())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn()
+    {
+        Ok(child) => child,
+        Err(_) => {
+            println!(
+                "{}",
+                serde_json::json!({"version":1,"verdict":"unsupported"})
+            );
+            return Ok(());
+        }
+    };
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(3);
+    let mut timed_out = false;
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break Some(status),
+            Ok(None) if std::time::Instant::now() < deadline => {
+                std::thread::sleep(std::time::Duration::from_millis(10));
+            }
+            _ => {
+                timed_out = true;
+                let _ = child.kill();
+                break child.wait().ok();
+            }
+        }
+    };
+    let waited = status.is_some();
+    let after = read_cgroup_oom_kill();
+    let killed_by_oom = !timed_out
+        && status
+            .as_ref()
+            .and_then(std::os::unix::process::ExitStatusExt::signal)
+            == Some(libc::SIGKILL)
+        && after.is_some_and(|count| count > before.unwrap_or(count));
+    println!(
+        "{}",
+        serde_json::json!({
+            "version":1, "verdict":if killed_by_oom { "pass" } else { "unsupported" },
+            "limit_bytes":expected, "oom_kill_increased":killed_by_oom,
+            "child_reaped":waited, "oom_group_disabled":true
+        })
+    );
+    Ok(())
+}
